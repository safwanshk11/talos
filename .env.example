# TALOS Environment Configuration

# Application
PROJECT_NAME="TALOS"
# "development" (default) or "production". In production, TALOS refuses to
# start if SECRET_KEY is still the published default below or if AI_PROVIDER
# is gemini without a GEMINI_API_KEY set (see app/core/config.py, Phase 8
# section 6) — in development those only log a warning.
ENVIRONMENT="development"
LOG_LEVEL="INFO"
# Change this in any real deployment — a deployment that leaves this at the
# published default lets anyone forge a valid TALOS session token.
SECRET_KEY="talos-super-secret-key-change-in-production-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=talos
POSTGRES_PASSWORD=talos_secret_pass
POSTGRES_DB=talos_db
DATABASE_URL=postgresql+asyncpg://talos:talos_secret_pass@postgres:5432/talos_db

# Local database URL for running backend directly outside docker
LOCAL_DATABASE_URL=postgresql+asyncpg://talos:talos_secret_pass@localhost:5432/talos_db

# GitHub Integration
# Option 1: GitHub OAuth App Credentials (Optional if using PAT directly)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/github/callback"

# Option 2: Default GitHub Personal Access Token (for local dev fallback)
GITHUB_PERSONAL_ACCESS_TOKEN=""

# CORS Origins (JSON array string or comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider (Phase 3: Planning & Patch Generation)
# "ollama" for local/dev reasoning (default), "gemini" for deployment.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2

# Ollama (local dev). From inside Docker on macOS/Windows this must be
# host.docker.internal, not localhost, to reach the host's Ollama server.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemini (deployment)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash

# Continuous Monitoring (Phase 7). GITHUB_WEBHOOK_SECRET must be set to the
# same secret configured on the GitHub repository's webhook (Settings ->
# Webhooks) for POST /api/v1/webhooks/github to accept anything at all —
# left empty, the endpoint refuses every request rather than trusting
# unverifiable payloads. Requires a publicly reachable backend URL, which a
# local docker compose deployment does not have on its own (e.g. via ngrok).
GITHUB_WEBHOOK_SECRET=""
MONITORING_SCHEDULER_INTERVAL_MINUTES=15
MONITORING_SCHEDULER_ENABLED=true

# Verification Engine (Phase 4). Images/limits for the disposable, no-secrets
# Docker sandbox each verification check runs in.
VERIFICATION_SANDBOX_IMAGE_NPM=node:20-slim
VERIFICATION_SANDBOX_IMAGE_PIP=python:3.11-slim
VERIFICATION_TIMEOUT_INSTALL=180
VERIFICATION_TIMEOUT_BUILD=180
VERIFICATION_TIMEOUT_TEST=180
VERIFICATION_TIMEOUT_DEFAULT=120
VERIFICATION_MEMORY_LIMIT=1g
VERIFICATION_CPU_LIMIT=1.5

# Production Hardening (Phase 8). Hours a completed job's patch workspace is
# kept on disk (for manual Verify/Deliver, review, diffing) before the
# background reaper reclaims it. Diffs/analysis/plan already live in the
# database and are never deleted — only the on-disk clone is reclaimed.
WORKSPACE_RETENTION_HOURS=24
